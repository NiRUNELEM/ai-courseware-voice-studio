# Optional Local GPU Voice Python Interpreter (when running manage.py from lightweight .venv)
# Example: VOICE_STUDIO_PYTHON=/path/to/cuda_venv/bin/python
VOICE_STUDIO_PYTHON=

# RVC Weights & Applio Checkout Directory
# Default locally: ./models/rvc | On Colab: /content/rvc_cache
RVC_ASSETS_ROOT=models/rvc

# Optional Seed-VC Checkout Directory (default: /content/seed-vc)
SEEDVC_DIR=

# Optional Hugging Face Token (only needed for gated models)
HF_TOKEN=

# Optional Google Colab CLI OAuth2 Token & Session Settings (auto-populated by `python studio.py mcp --login --mode colab_cli`)
COLAB_CLI_OAUTH_TOKEN_JSON=
COLAB_CLI_SESSION_NAME=voice-studio-pro

# Optional Antigravity Google Drive Plugin CLI Path (auto-detected if on PATH or /tmp/agy-plugin-cli-*)
GDRIVE_CLI_BINARY=

# Optional Desktop Live Terminal Monitor Window ("1" to pop open a terminal window tailing live_terminal.log during Colab runs)
VOICE_STUDIO_OPEN_TERMINAL=0

# Optional Google Colab Remote HTTP Agent Bridge
COLAB_AGENT_URL=
COLAB_AGENT_TOKEN=

# Optional Google Drive OAuth2 / Sync Bridge
GOOGLE_CLIENT_SECRETS=.colab_auth/client_secrets.json
GOOGLE_TOKEN_PATH=.colab_auth/token.json
GOOGLE_DRIVE_MOUNT_DIR=
