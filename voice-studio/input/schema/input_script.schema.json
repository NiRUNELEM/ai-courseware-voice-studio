{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice & Media Studio Script Input Schema",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "title": { "type": "string", "description": "Display title rendered in HTML5 players" },
    "slides_png_dir": { "type": "string", "description": "Optional directory containing slide_01.png, slide_02.png, ..." },
    "pptx_path": { "type": "string", "description": "Optional PowerPoint (.pptx) deck used for visual slides & progressive reveals" },
    "timeline_json": { "type": "string", "description": "Optional precomputed reveal timing JSON" },
    "reveal_manifest": { "type": "string", "description": "Optional bounding-box reveal hierarchy JSON" },
    "reveal_key": { "type": "string", "description": "Optional key inside reveal_manifest" },
    "extra_vocab_path": { "type": "string", "description": "Optional JSON phonetic override file merged on top of default dictionary" },
    "phonetic_vocab": {
      "type": "object",
      "description": "Optional inline Thai pronunciation overrides for project-specific terms",
      "properties": {
        "exact_compounds": { "type": "array" },
        "phrases": { "type": "array" },
        "words": { "type": "object" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "slide_no": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "raw_title": { "type": "string" },
          "pacing": { "type": "string", "enum": ["normal", "slow", "fast"] },
          "duration_est_sec": { "type": "number", "minimum": 0 },
          "items": { "type": "array", "items": { "type": "string" } },
          "script": { "type": "string" },
          "phonetic_items": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
